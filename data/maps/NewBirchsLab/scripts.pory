mapscripts NewBirchsLab_MapScripts
{
    MAP_SCRIPT_ON_TRANSITION: NewBirchsLab_EventScript_BallDefault
}

script NewBirchsLab_EventScript_BallDefault
{
    setvar(VAR_STARTER_REGION, 0)
}

script NewBirchsLab_EventScript_Birch
{
    // Låt spelaren bara välja region om ingen starter är vald ännu
    if(!(flag(FLAG_CHOSEN_GRASS_TYPE) || flag(FLAG_CHOSEN_WATER_TYPE) || flag(FLAG_CHOSEN_FIRE_TYPE)))
    {
        lock
        faceplayer

        message("Would you like to switch regions?")

        // Använd scrollable multichoice istället för vanlig multichoice
        setvar(VAR_0x8004, SCROLL_MULTI_REGION_SELECT)
        special(ShowScrollableMultichoice)
        waitstate      // vänta tills spelaren gjort sitt val

        // Här ligger valet i VAR_RESULT:
        // 0 = Kanto, 1 = Johto, ..., 8 = Paldea
        if (var(VAR_RESULT) == 0)
        {
            call(StarterFade)
            setvar(VAR_STARTER_REGION, 0) // Kanto
        }
        elif (var(VAR_RESULT) == 1)
        {
            call(StarterFade)
            setvar(VAR_STARTER_REGION, 1) // Johto
        }
        elif (var(VAR_RESULT) == 2)
        {
            call(StarterFade)
            setvar(VAR_STARTER_REGION, 2) // Hoenn
        }
        elif (var(VAR_RESULT) == 3)
        {
            call(StarterFade)
            setvar(VAR_STARTER_REGION, 3) // Sinnoh
        }
        elif (var(VAR_RESULT) == 4)
        {
            call(StarterFade)
            setvar(VAR_STARTER_REGION, 4) // Unova
        }
        elif (var(VAR_RESULT) == 5)
        {
            call(StarterFade)
            setvar(VAR_STARTER_REGION, 5) // Kalos
        }
        elif (var(VAR_RESULT) == 6)
        {
            call(StarterFade)
            setvar(VAR_STARTER_REGION, 6) // Alola
        }
        elif (var(VAR_RESULT) == 7)
        {
            call(StarterFade)
            setvar(VAR_STARTER_REGION, 7) // Galar
        }
        elif (var(VAR_RESULT) == 8)
        {
            call(StarterFade)
            setvar(VAR_STARTER_REGION, 8) // Paldea
        }
        // Om spelaren trycker B, brukar VAR_RESULT bli MULTI_B_PRESSED.
        // Du kan kolla på det också om du vill göra något speciellt då.

        msgbox("Choose wisely...")
        waitmessage
        release
        end
    }
    else
    {
        msgbox("Take care of your Pokémon.", MSGBOX_NPC)
        end
    }
}

script StarterFade
{
    fadescreen(FADE_TO_BLACK)
    delay(20)
    fadescreen(FADE_FROM_BLACK)
    return
}

script NewBirchsLab_EventScript_GrassStarter
{
    lockall

    if (flag(FLAG_CHOSEN_GRASS_TYPE) || flag(FLAG_CHOSEN_WATER_TYPE) || flag(FLAG_CHOSEN_FIRE_TYPE))
    {
        msgbox("Don't take another Pokémon.")
        waitmessage
        releaseall
        end
    }

    // Välj Grass-mon beroende på region
    switch (var(VAR_STARTER_REGION))
    {
    case 0:  // Kanto
        setvar(VAR_STARTER_SPECIES, SPECIES_BULBASAUR)
        break
    case 1:  // Johto
        setvar(VAR_STARTER_SPECIES, SPECIES_CHIKORITA)
        break
    case 2:  // Hoenn
        setvar(VAR_STARTER_SPECIES, SPECIES_TREECKO)
        break
    case 3:  // Sinnoh
        setvar(VAR_STARTER_SPECIES, SPECIES_TURTWIG)
        break
    case 4:  // Unova
        setvar(VAR_STARTER_SPECIES, SPECIES_SNIVY)
        break
    case 5:  // Kalos
        setvar(VAR_STARTER_SPECIES, SPECIES_CHESPIN)
        break
    case 6:  // Alola
        setvar(VAR_STARTER_SPECIES, SPECIES_ROWLET)
        break
    case 7:  // Galar
        setvar(VAR_STARTER_SPECIES, SPECIES_GROOKEY)
        break
    case 8:  // Paldea
        setvar(VAR_STARTER_SPECIES, SPECIES_SPRIGATITO)
        break
    }
    call(ShowStarterPicBySpecies)
    call(GiveStarterFromVar)
    if (var(VAR_RESULT) == YES)   // bara om spelaren faktiskt valde Pokémon
    {
        setflag(FLAG_CHOSEN_GRASS_TYPE)
        removeobject(1)
    }
    releaseall
    end
}

