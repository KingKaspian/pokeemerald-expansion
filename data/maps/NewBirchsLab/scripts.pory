        break
    case SPECIES_SPRIGATITO:
        showmonpic(SPECIES_SPRIGATITO, 10, 3)
        break
    case SPECIES_SQUIRTLE:
        showmonpic(SPECIES_SQUIRTLE, 10, 3)
        break
    case SPECIES_TOTODILE:
        showmonpic(SPECIES_TOTODILE, 10, 3)
        break
    case SPECIES_MUDKIP:
        showmonpic(SPECIES_MUDKIP, 10, 3)
        break
    case SPECIES_PIPLUP:
        showmonpic(SPECIES_PIPLUP, 10, 3)
        break
    case SPECIES_OSHAWOTT:
        showmonpic(SPECIES_OSHAWOTT, 10, 3)
        break
    case SPECIES_FROAKIE:
        showmonpic(SPECIES_FROAKIE, 10, 3)
        break
    case SPECIES_POPPLIO:
        showmonpic(SPECIES_POPPLIO, 10, 3)
        break
    case SPECIES_SOBBLE:
        showmonpic(SPECIES_SOBBLE, 10, 3)
        break
    case SPECIES_QUAXLY:
        showmonpic(SPECIES_QUAXLY, 10, 3)
        break
    case SPECIES_CHARMANDER:
        showmonpic(SPECIES_CHARMANDER, 10, 3)
        break
    case SPECIES_CYNDAQUIL:
        showmonpic(SPECIES_CYNDAQUIL, 10, 3)
        break
    case SPECIES_TORCHIC:
        showmonpic(SPECIES_TORCHIC, 10, 3)
        break
    case SPECIES_CHIMCHAR:
        showmonpic(SPECIES_CHIMCHAR, 10, 3)
        break
    case SPECIES_TEPIG:
        showmonpic(SPECIES_TEPIG, 10, 3)
        break
    case SPECIES_FENNEKIN:
        showmonpic(SPECIES_FENNEKIN, 10, 3)
        break
    case SPECIES_LITTEN:
        showmonpic(SPECIES_LITTEN, 10, 3)
        break
    case SPECIES_SCORBUNNY:
        showmonpic(SPECIES_SCORBUNNY, 10, 3)
        break
    case SPECIES_FUECOCO:
        showmonpic(SPECIES_FUECOCO, 10, 3)
        break
    default:
        // Fallback: välj t.ex. Bulbasaur-bild
        showmonpic(SPECIES_BULBASAUR, 10, 3)
        break
    }
    return
}


script NicknamePartyMon
{
    msgbox("Give it a nickname?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES)
    {
        call(Common_EventScript_GetGiftMonPartySlot)
        call(Common_EventScript_NameReceivedPartyMon)
    }
    return
}

script NicknameBoxMon
{
    msgbox("Give it a nickname?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES)
    {
        call(Common_EventScript_NameReceivedBoxMon)
    }
    msgbox("Transferred to PC")
    return
}

text NewBirchsLab_NotChosen
{
    "You did not choose a Pokémon."
}