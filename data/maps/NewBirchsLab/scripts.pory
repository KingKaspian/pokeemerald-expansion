script GiveStarterFromVar
{
    msgbox("Do you want to choose this Pokémon?", MSGBOX_YESNO)
    if(var(VAR_RESULT) != YES)
    {
        hidemonpic
        setvar(VAR_RESULT, 0)
        return
    }
    if (var(VAR_RESULT) == YES)
    {
        givemon(VAR_STARTER_SPECIES, 5)
        
        if (var(VAR_RESULT) == MON_GIVEN_TO_PARTY)
        {
            setflag(FLAG_SYS_POKEMON_GET)
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Received a Pokémon!")
            hidemonpic
            call(NicknamePartyMon)
            setvar(VAR_RESULT, YES)
        }
        elif (var(VAR_RESULT) == MON_GIVEN_TO_PC)
        {
            setflag(FLAG_SYS_POKEMON_GET)
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Received a Pokémon! (sent to PC)")
            hidemonpic
            call(NicknameBoxMon)
            setvar(VAR_RESULT, YES)
        }
        else
        {
            // full party + full boxes
            msgbox("No more room.")
            hidemonpic
            setvar(VAR_RESULT, 0)
        }
    }
    return
}

script ShowStarterPicBySpecies
{
    // Visa rätt bild beroende på VAR_STARTER_SPECIES
    switch (var(VAR_STARTER_SPECIES))
    {
    case SPECIES_BULBASAUR:
        showmonpic(SPECIES_BULBASAUR, 10, 3)
        break
    case SPECIES_CHIKORITA:
        showmonpic(SPECIES_CHIKORITA, 10, 3)
        break
    case SPECIES_TREECKO:
        showmonpic(SPECIES_TREECKO, 10, 3)
        break
